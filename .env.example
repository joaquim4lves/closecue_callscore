# Postgres connection for the single Next.js server.
# Placeholders only — do not commit real credentials.
DATABASE_URL=postgres://closecue:closecue@127.0.0.1:5432/closecue

# Mock auth is the only auth mode. There is no Clerk project and no Clerk key.
# Set to false to hide the dev user directory (GET /api/dev/users, POST /api/dev/session).
# API calls still accept the x-mock-user-id header or the mock_user_id cookie.
MOCK_AUTH=true

# Zoom webhook (fatia 2). Placeholders only.
# Event subscription URL: POST https://<host>/api/webhooks/zoom
ZOOM_WEBHOOK_SECRET_TOKEN=replace-with-zoom-secret-token
ZOOM_ORG_ID=11111111-1111-4111-8111-111111111111
ZOOM_DEFAULT_SELLER_ID=33333333-3333-4333-8333-333333333333

# mock returns one segment. fail marks the call failed.
STT_PROVIDER=mock

# mock scores with playbook rules. fail stores scores.status=failed.
SCORE_PROVIDER=mock
# Used only when the org has no retention row yet. Otherwise bad_score_below (default 60) wins.
SCORE_BAD_BELOW=60

# enforce rejects real audio unless consentRecordedAt is present.
# Production (NODE_ENV=production) always enforces this gate.
AUDIO_CONSENT_GATE=off
