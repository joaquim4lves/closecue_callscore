# Postgres connection for the single Next.js server.
# Placeholders only — do not commit real credentials.
DATABASE_URL=postgres://closecue:closecue@127.0.0.1:5432/closecue

# Mock auth is the only auth mode. There is no Clerk project and no Clerk key.
# Set to false to hide the dev user directory (GET /api/dev/users, POST /api/dev/session).
# API calls still accept the x-mock-user-id header or the mock_user_id cookie.
MOCK_AUTH=true
